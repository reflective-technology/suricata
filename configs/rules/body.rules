# Request-body marker signatures (ruleset body-v1). Category in the msg prefix.
alert http any any -> any any (msg:"BODY sqli quote OR"; flow:to_server,established; http.request_body; content:"' or "; nocase; sid:9100001; rev:1;)
alert http any any -> any any (msg:"BODY sqli or 1=1"; flow:to_server,established; http.request_body; content:"or 1=1"; nocase; sid:9100002; rev:1;)
alert http any any -> any any (msg:"BODY sqli union select"; flow:to_server,established; http.request_body; content:"union"; nocase; content:"select"; nocase; distance:0; within:20; sid:9100003; rev:1;)
alert http any any -> any any (msg:"BODY sqli sleep("; flow:to_server,established; http.request_body; content:"sleep("; nocase; sid:9100004; rev:1;)
alert http any any -> any any (msg:"BODY sqli benchmark("; flow:to_server,established; http.request_body; content:"benchmark("; nocase; sid:9100005; rev:1;)
alert http any any -> any any (msg:"BODY sqli quote comment"; flow:to_server,established; http.request_body; content:"'--"; sid:9100006; rev:1;)
alert http any any -> any any (msg:"BODY sqli boolean tautology"; flow:to_server,established; http.request_body; content:"="; pcre:"/\b(?:or|and)\s+\d+\s*=\s*\d+/i"; sid:9100007; rev:1;)
